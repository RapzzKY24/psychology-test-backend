# Database — refer docs/standards/tech-versions.md (Postgres 16) & docs/standards/nestjs-prisma.md
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psychology_test?schema=public"

# App — BE di 4000, FE nanti di 3000 (sesuai request)
PORT=4000
PAYMENT_TTL_MIN=60
SESSION_DEFAULT_TTL_DAYS=30
UPLOAD_DIR=./uploads

# Email — refer docs/standards/email.md (Mailtrap dev, Resend prod)
EMAIL_PROVIDER="mailtrap"
MAILTRAP_HOST="smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="xxx"
MAILTRAP_PASS="xxx"
MAIL_FROM="noreply@psychology-test.local"
RESEND_API_KEY="re_xxx"
RESEND_FROM="noreply@yourdomain.com"

# Better Auth — refer docs/standards/better-auth.md
BETTER_AUTH_SECRET="change-me-32-chars-min"
BETTER_AUTH_URL="http://localhost:4000"

# Payments — provider: manual (static QRIS, ADR-008) | jokul (Virtual Account / QRIS)
PAYMENT_PROVIDER="jokul"       # manual | midtrans | jokul — flip to midtrans at cutover

# Payments recovery job (VA reconciliation + stale callback replay)
PAYMENT_RECOVERY_INTERVAL_MIN=5
PAYMENT_RECOVERY_STALE_MIN=5
PAYMENT_RECOVERY_LOOKBACK_MIN=1440
PAYMENT_RECOVERY_BATCH=50

# Jokul (Virtual Account, SNAP) — refer developers.doku.com
JOKUL_STUB="false"             # true = deterministic in-memory VA provider (dev/test, no network)
JOKUL_BASE_URL="https://api-sandbox.doku.com"    # rollback only
JOKUL_CLIENT_ID=""             # Jokul client id (X-CLIENT-KEY / X-PARTNER-ID)
JOKUL_PRIVATE_KEY=""           # RSA private key (PEM); use \n for newlines
JOKUL_SECRET_KEY=""            # HMAC-SHA512 secret for request + callback signatures
JOKUL_PARTNER_SERVICE_ID=""    # company code / BIN prefixing the VA number
JOKUL_CHANNEL_ID="H2H"
JOKUL_BANK_CODE="JOKUL"        # label stored on order/invoice vaBankCode
JOKUL_CALLBACK_URL=""          # public URL Jokul posts VA callbacks to

# Midtrans Snap — refer docs.midtrans.com
MIDTRANS_STUB="true"                  # true = deterministic in-memory Snap provider (dev/test, no network)
MIDTRANS_IS_PRODUCTION="false"        # false = sandbox endpoints
MIDTRANS_SERVER_KEY=""                # Midtrans server key (Basic auth, also signs notifications)
MIDTRANS_CLIENT_KEY=""                # Midtrans client key (frontend snap.js)
MIDTRANS_FINISH_URL=""                # redirect target after the customer finishes paying
