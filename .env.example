# Database — refer docs/standards/tech-versions.md (Postgres 16) & docs/standards/nestjs-prisma.md
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psychology_test?schema=public"

# App — BE di 4000, FE nanti di 3000 (sesuai request)
PORT=4000
PAYMENT_TTL_MIN=60
SESSION_DEFAULT_TTL_DAYS=30
UPLOAD_DIR=./uploads

# QR verifikasi (invoice, laporan, sertifikat) — WAJIB. Tanpa ini dokumen
# ditolak, bukan dicetak dengan QR yang tidak bisa dipindai.
APP_PUBLIC_URL="https://psikologitest.id"
INVOICE_LOGO_PATH="./assets/invoice/logo.jpeg"

# Email — refer docs/standards/email.md (Mailtrap dev, Resend prod)
EMAIL_PROVIDER="mailtrap"
MAILTRAP_HOST="smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="xxx"
MAILTRAP_PASS="xxx"
MAIL_FROM="noreply@psychology-test.local"
RESEND_API_KEY="re_xxx"
RESEND_FROM="noreply@yourdomain.com"

# Better Auth — refer docs/standards/better-auth.md
BETTER_AUTH_SECRET="change-me-32-chars-min"
BETTER_AUTH_URL="http://localhost:4000"
# Origin tambahan yang boleh memanggil /api/v1/auth (dipisah koma). Origin
# BETTER_AUTH_URL sudah otomatis dipercaya; isi ini hanya untuk domain lain,
# mis. "https://psikologitest.id,https://www.psikologitest.id". Kosong = tidak ada.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Payments — which transport is bound
PAYMENT_PROVIDER="midtrans"    # manual | midtrans | doku ('manual' disables the gateway)

# How long an invoice stays payable (minutes). Separate from SESSION_DEFAULT_TTL_DAYS:
# the batch may stay open a month, the payment link should not.
INVOICE_PAYMENT_TTL_MIN=1440

# Payments recovery job (status reconciliation + stale notification replay)
PAYMENT_RECOVERY_INTERVAL_MIN=5
PAYMENT_RECOVERY_STALE_MIN=5
PAYMENT_RECOVERY_LOOKBACK_MIN=1440
PAYMENT_RECOVERY_BATCH=50

# Midtrans Snap — refer docs.midtrans.com
MIDTRANS_STUB="true"                  # true = deterministic in-memory Snap provider (dev/test, no network)
MIDTRANS_IS_PRODUCTION="false"        # false = sandbox endpoints
MIDTRANS_SERVER_KEY=""                # Midtrans server key (Basic auth, also signs notifications)
MIDTRANS_CLIENT_KEY=""                # Midtrans client key (frontend snap.js)
MIDTRANS_FINISH_URL=""                # redirect target after the customer finishes paying

# Doku Checkout — refer docs.doku.com
DOKU_STUB="false"                     # true = deterministic in-memory provider (dev/test, no network)
DOKU_IS_PRODUCTION="false"            # false = api-sandbox.doku.com
DOKU_CLIENT_ID=""                     # Doku Client-Id header
DOKU_SECRET_KEY=""                    # Doku secret key (HMAC-SHA256; also verifies callbacks)
DOKU_NOTIFICATION_PATH="/api/v1/webhooks/doku/notification"  # must equal the Notification URL in the Doku dashboard
DOKU_RESULT_URL_BASE=""               # e.g. https://mypsikolog.id/pembayaran — the reference id is appended

# Admin seed — dipakai `npm run seed:admin` untuk membuat akun ADMIN pertama
ADMIN_EMAIL="admin@psychology-test.local"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="change-me-min-8-chars"

# Instansi seed — dipakai `npm run seed:instansi` untuk membuat akun INSTANSI percobaan
INSTANSI_EMAIL="instansi@psychology-test.local"
INSTANSI_NAME="PT Contoh Instansi"
INSTANSI_PASSWORD="change-me-min-8-chars"
