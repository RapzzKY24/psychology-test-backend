generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PSYCHOLOGIST
  PARTICIPANT
  INSTANSI
}

enum ResultStatus {
  PENDING_REVIEW
  APPROVED
  RETURNED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum TestCategory {
  PERSONALITY
  COGNITIVE
  WORK_STYLE
  INTEREST
  PROJECTIVE
}

enum ScorerType {
  FORCED_CHOICE_DISC
  FORCED_CHOICE_PAIR
  RIGHT_WRONG_NORM
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JoinMode {
  OPEN
  ROSTER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum SessionKind {
  INDIVIDUAL
  GROUP
}

enum SessionStatus {
  PENDING_PAYMENT
  ACTIVE
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum DeliveryChannel {
  PDF
  EMAIL
}

enum IdType {
  NIK
  PASPOR
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum PaymentProvider {
  MANUAL_QRIS
  JOKUL_VA
  MIDTRANS_SNAP
  DOKU_CHECKOUT
}

enum PaymentVerifiedBySource {
  ADMIN
  JOKUL
  MIDTRANS
  DOKU
}

enum EventSource {
  JOKUL
  MANUAL
  MIDTRANS
  DOKU
}

enum EventDirection {
  INBOUND
  OUTBOUND
}

enum EventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Better Auth — see docs/standards/better-auth.md §4 (additionalFields role) + §5 admin plugin
enum ReportStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum RatingCategory {
  R
  K
  C
  B
  T
}

enum Recommendation {
  LAYAK
  BELUM_LAYAK
  TIDAK_LAYAK
}

enum CertificateStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum CertificateVerdict {
  MEMENUHI_SYARAT
  TIDAK_MEMENUHI_SYARAT
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  role          String        @default("PARTICIPANT")
  banned        Boolean       @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  institutions  Institution[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Test {
  id                   String           @id @default(uuid()) @db.Uuid
  slug                 String           @unique
  name                 String
  description          String
  /**
   * Public cover image URL (`/uploads/test-covers/<uuid>.<ext>`), null when unset.
   */
  imageUrl             String?
  category             TestCategory
  scorerType           ScorerType
  price                Int
  estimatedDurationMin Int
  /**
   * Hard time limit enforced from `Attempt.startedAt`; null means untimed.
   * Distinct from `estimatedDurationMin`, which is only catalog copy.
   */
  timeLimitMin         Int?
  /** Raw -> IQ conversion rows (`{ raw, iq }`); null when the test has no norm. */
  normTable            Json?
  /**
   * Age range the norm is valid for, in whole months (e.g. 168-179 = 14y0m to
   * 14y11m). Null when the instrument's norm is not banded, which means the
   * test page must not gate anyone on age.
   */
  ageMinMonths         Int?
  ageMaxMonths         Int?
  status               TestStatus       @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  items                TestItem[]
  interpretations      Interpretation[]
  sessionTests         SessionTest[]
  orders               Order[]
  attempts             Attempt[]

  @@map("tests")
}

model TestItem {
  id      String @id @default(uuid()) @db.Uuid
  testId  String @db.Uuid
  order   Int
  content Json

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, order])
  @@map("test_items")
}

model Interpretation {
  id          String @id @default(uuid()) @db.Uuid
  testId      String @db.Uuid
  patternCode String
  title       String
  body        String

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, patternCode])
  @@map("interpretations")
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  excerpt     String
  coverPath   String?
  content     Json
  category    String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("articles")
}

model Institution {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  contactName             String
  contactEmail            String
  phone                   String?
  address                 String?
  notes                   String?
  ownerUserId             String?                  @unique
  ownerUser               User?                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                TestSession[]
  invoices                Invoice[]
  institutionParticipants InstitutionParticipant[]

  @@map("institutions")
}

model InstitutionParticipant {
  id                 String      @id @default(uuid()) @db.Uuid
  institutionId      String      @db.Uuid
  name               String
  destinationCountry String
  idType             IdType
  idNumber           String
  birthDate          DateTime?
  education          String?
  phone              String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  seats SessionParticipant[]

  @@unique([institutionId, idNumber])
  @@index([institutionId])
  @@map("institution_participants")
}

model TestSession {
  id            String               @id @default(uuid()) @db.Uuid
  kind          SessionKind
  institutionId String?              @db.Uuid
  createdById   String?
  title         String
  token         String               @unique
  pinHash       String?
  slotLimit     Int
  expiresAt     DateTime
  status        SessionStatus        @default(ACTIVE)
  joinMode      JoinMode             @default(OPEN)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  institution   Institution?         @relation(fields: [institutionId], references: [id])
  sessionTests  SessionTest[]
  participants  SessionParticipant[]
  attempts      Attempt[]
  invoice       Invoice?

  @@map("test_sessions")
}

model PsychologistProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique
  fullName           String
  degree             String
  licenseNumber      String
  sippNumber         String?
  nik                String?  @unique
  institutionName    String?
  signatureImagePath String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("psychologist_profiles")
}

model SessionTest {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @db.Uuid
  testId       String @db.Uuid
  order        Int
  timeLimitSec Int? // reserved for the timer engine (cognitive phase, test-library-mechanics §2.E/F) — no logic in MVP

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  test    Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([sessionId, testId])
  @@map("session_tests")
}

model SessionParticipant {
  id                       String                  @id @default(uuid()) @db.Uuid
  sessionId                String                  @db.Uuid
  name                     String
  email                    String?
  candidateNumber          String?
  tokenHash                String?                 @unique
  claimedAt                DateTime?
  phone                    String?
  institutionParticipantId String?                 @db.Uuid
  joinedAt                 DateTime                @default(now())
  session                  TestSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  institutionParticipant   InstitutionParticipant? @relation(fields: [institutionParticipantId], references: [id], onDelete: SetNull)
  attempts                 Attempt[]
  reports                  Report[]

  @@index([institutionParticipantId])
  @@map("session_participants")
}

model Attempt {
  id            String              @id @default(uuid()) @db.Uuid
  sessionId     String              @db.Uuid
  testId        String              @db.Uuid
  userId        String?
  participantId String?             @db.Uuid
  status        AttemptStatus       @default(IN_PROGRESS)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  session       TestSession         @relation(fields: [sessionId], references: [id])
  test          Test                @relation(fields: [testId], references: [id])
  participant   SessionParticipant? @relation(fields: [participantId], references: [id])
  responses     Response[]
  result        TestResult?

  @@index([sessionId])
  @@index([testId])
  @@map("attempts")
}

model Response {
  id         String   @id @default(uuid()) @db.Uuid
  attemptId  String   @db.Uuid
  itemId     String   @db.Uuid
  value      Json
  answeredAt DateTime @default(now())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemId])
  @@map("responses")
}

model TestResult {
  id                   String           @id @default(uuid()) @db.Uuid
  attemptId            String           @unique @db.Uuid
  scores               Json
  patternCode          String
  correctedScores      Json?
  correctedPatternCode String?
  correctionReason     String?
  correctedById        String?
  correctedAt          DateTime?
  notes                String?
  notesUpdatedAt       DateTime?
  status               ResultStatus     @default(PENDING_REVIEW)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  verifyCode           String?          @unique
  computedAt           DateTime         @default(now())
  attempt              Attempt          @relation(fields: [attemptId], references: [id])
  deliveries           ReportDelivery[]
  certificates         Certificate[]

  @@index([status])
  @@map("test_results")
}

model Report {
  id             String             @id @default(uuid()) @db.Uuid
  participantId  String             @db.Uuid
  status         ReportStatus       @default(DRAFT)
  ratings        Json               @default("{}")
  narratives     Json               @default("{}")
  recommendation Recommendation?
  filledById     String?
  filledAt       DateTime?
  number         String?
  seq            Int?
  year           Int?
  revision       Int?
  verifyCode     String?            @unique
  snapshot       Json?
  issuedAt       DateTime?
  issuedById     String?
  supersedesId   String?            @unique @db.Uuid
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  participant    SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  supersedes     Report?            @relation("ReportRevision", fields: [supersedesId], references: [id])
  supersededBy   Report?            @relation("ReportRevision")

  @@unique([participantId, revision])
  // A revision keeps the same number, so uniqueness is per revision — not per
  // number alone.
  @@unique([number, revision])
  @@index([status])
  @@index([year, seq])
  @@map("reports")
}

/// One-page certificate for a non-WPT test result. Same numbering and revision
/// rules as Report, but anchored on TestResult: a personal purchase has no
/// SessionParticipant, so the result is the only anchor covering both flows.
model Certificate {
  id       String            @id @default(uuid()) @db.Uuid
  resultId String            @db.Uuid
  status   CertificateStatus @default(DRAFT)

  // entered by the psychologist
  identity   Json                @default("{}")
  verdict    CertificateVerdict?
  purpose    String?
  validUntil DateTime?
  photoPath  String?
  filledById String?
  filledAt   DateTime?

  // issued document
  number     String?
  seq        Int?
  year       Int?
  revision   Int?
  verifyCode String?   @unique
  snapshot   Json?
  issuedAt   DateTime?
  issuedById String?

  supersedesId String?   @unique @db.Uuid
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result       TestResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  supersedes   Certificate? @relation("CertificateRevision", fields: [supersedesId], references: [id])
  supersededBy Certificate? @relation("CertificateRevision")

  @@unique([resultId, revision])
  // A revision keeps the same number, so uniqueness is per revision — not per
  // number alone.
  @@unique([number, revision])
  @@index([status])
  @@index([year, seq])
  @@map("certificates")
}

model Invoice {
  id                String                   @id @default(uuid()) @db.Uuid
  institutionId     String                   @db.Uuid
  number            String                   @unique
  verificationToken String                   @unique @default(uuid())
  amount            Int
  status            InvoiceStatus            @default(UNPAID)
  issuedAt          DateTime                 @default(now())
  dueDate           DateTime?
  notes             String?
  sessionId         String?                  @unique @db.Uuid
  expiresAt         DateTime?
  paymentProvider   PaymentProvider?
  vaNumber          String?                  @unique
  vaBankCode        String?
  providerOrderId   String?                  @unique
  paymentToken      String?
  paymentUrl        String?
  paymentType       String?
  verifiedBySource  PaymentVerifiedBySource?
  verifiedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  institution       Institution              @relation(fields: [institutionId], references: [id])
  session           TestSession?             @relation(fields: [sessionId], references: [id])

  @@index([vaNumber])
  @@map("invoices")
}

model Order {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String
  testId           String                   @db.Uuid
  basePrice        Int
  uniqueCode       Int
  amount           Int
  status           OrderStatus              @default(PENDING)
  expiresAt        DateTime
  userClaimedAt    DateTime?
  verifiedById     String?
  verifiedBySource PaymentVerifiedBySource?
  verifiedAt       DateTime?
  cancelReason     String?
  paymentProvider  PaymentProvider?
  vaNumber         String?
  vaBankCode       String?
  providerOrderId  String?                  @unique
  paymentToken     String?
  paymentUrl       String?
  paymentType      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  test             Test                     @relation(fields: [testId], references: [id])

  @@index([userId])
  @@index([status, amount])
  @@index([vaNumber])
  @@map("orders")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ReportDelivery {
  id        String          @id @default(uuid()) @db.Uuid
  resultId  String          @db.Uuid
  channel   DeliveryChannel
  recipient String
  status    DeliveryStatus
  sentAt    DateTime
  error     String?
  result    TestResult      @relation(fields: [resultId], references: [id])

  @@map("report_deliveries")
}

model EventLog {
  id             String         @id @default(uuid()) @db.Uuid
  source         EventSource
  direction      EventDirection
  type           String
  status         EventStatus    @default(RECEIVED)
  aggregateType  String?
  aggregateId    String?        @db.Uuid
  reference      String?
  idempotencyKey String?
  payload        Json?
  response       Json?
  httpStatus     Int?
  errorMessage   String?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  processedAt    DateTime?
  updatedAt      DateTime       @updatedAt

  @@index([aggregateType, aggregateId])
  @@index([status, createdAt])
  @@index([idempotencyKey])
  @@map("event_log")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  key            String            @unique
  scope          String
  requestHash    String?
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  errorMessage   String?
  lockedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([scope, createdAt])
  @@map("idempotency_keys")
}
